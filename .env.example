SERVER_PORT=8080
SERVER_MAX_UPLOAD_MB=100

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tempcdn-files
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://cdn.tempcdn.example.com

# Single standalone instance (default): local SQLite file, not shared with
# any other server.
DATABASE_DSN=file:tempcdn.db?cache=shared&_fk=1&_journal_mode=WAL&_busy_timeout=5000
#
# Multiple instances sharing one metadata store (e.g. srv1/srv2/srv3 behind
# a rotating/round-robin frontend, all pointing at the same domain rotation)
# MUST use a shared Postgres database instead — a "postgres://" or
# "postgresql://" DSN switches to PostgresRepository automatically:
# DATABASE_DSN=postgres://tempcdn:change-me@postgres-host:5432/tempcdn?sslmode=require
FILE_TTL_HOURS=24
FILE_SWEEP_INTERVAL_MINUTES=5

SERVER_MAX_CONCURRENT_UPLOADS=50

# Required — the server refuses to start with the well-known insecure
# default. Generate with e.g. `openssl rand -hex 32`.
IP_HASH_SALT=change-me-to-a-random-secret
# Set to true only for local development if you don't want to set a real
# IP_HASH_SALT yet. Never set this in production.
ALLOW_INSECURE_IP_HASH_SALT=false

# Origin allowed to call this API from a browser (e.g. https://tempcdn.eu.cc).
# Required — the server refuses to start without it.
ALLOWED_ORIGIN=https://tempcdn.eu.cc

# If set, required (as X-Metrics-Token header or Authorization: Bearer) to
# read /metrics. Leave unset only if /metrics is not publicly reachable.
METRICS_TOKEN=

ALLOWED_MIME_TYPES=image/*,video/*,application/pdf,application/zip,text/plain
BLOCKED_EXTENSIONS=.exe,.bat,.sh,.msi,.dll,.scr

# When true, deleting a file before its TTL also purges its CDN_URL from
# Cloudflare's edge cache. Requires CLOUDFLARE_ZONE_ID and CLOUDFLARE_API_TOKEN.
CLOUDFLARE_CACHE_ENABLED=false
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
