SERVER_PORT=8080
SERVER_MAX_UPLOAD_MB=100

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tempcdn-files
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://cdn.tempcdn.example.com

# Required — must be a "postgres://" or "postgresql://" connection string.
# Postgres is required for every deployment, including a single standalone
# instance, not just multi-instance setups.
#
# Single standalone instance:
# DATABASE_DSN=postgres://tempcdn:change-me@localhost:5432/tempcdn?sslmode=require
#
# Multiple instances sharing one metadata store (e.g. srv1/srv2/srv3 behind
# a rotating/round-robin frontend, all pointing at the same domain rotation)
# point at the same shared Postgres database:
DATABASE_DSN=postgres://tempcdn:change-me@postgres-host:5432/tempcdn?sslmode=require
# Caps the Postgres connection pool for this instance. Kept small by
# default since managed providers (e.g. Aiven's smaller tiers) often
# reserve only a handful of non-superuser connection slots — exceeding
# them fails startup with "remaining connection slots are reserved for
# roles with the SUPERUSER attribute". In a multi-instance deployment,
# this value is effectively multiplied by the number of instances sharing
# the database, so lower it accordingly if you raise instance count.
DATABASE_MAX_CONNS=5
FILE_TTL_HOURS=24
FILE_SWEEP_INTERVAL_MINUTES=5

# Node liveness (GET /api/v1/nodes) — each instance heartbeats its own row
# and any live instance flags a peer offline once its heartbeat goes stale.
# Only meaningful when multiple instances share one Postgres DATABASE_DSN.
#
# Unique per instance, e.g. srv1 / srv2 / srv3. If left unset, a random
# suffix is appended to the hostname instead so instances don't collide,
# but setting this explicitly is recommended for stable, readable rows.
NODE_ID=
NODE_HEARTBEAT_INTERVAL_SECONDS=15
# Must be greater than NODE_HEARTBEAT_INTERVAL_SECONDS.
NODE_STALE_AFTER_SECONDS=45
NODE_JANITOR_INTERVAL_SECONDS=20

SERVER_MAX_CONCURRENT_UPLOADS=50

# Required — the server refuses to start with the well-known insecure
# default. Generate with e.g. `openssl rand -hex 32`.
IP_HASH_SALT=change-me-to-a-random-secret
# Set to true only for local development if you don't want to set a real
# IP_HASH_SALT yet. Never set this in production.
ALLOW_INSECURE_IP_HASH_SALT=false

# Origin allowed to call this API from a browser (e.g. https://tempcdn.eu.cc).
# Required — the server refuses to start without it.
ALLOWED_ORIGIN=https://tempcdn.eu.cc

# /metrics requires either a valid admin session token or an API key (as
# X-Metrics-Token header or Authorization: Bearer), sent via the same
# headers. API keys are created from the admin dashboard after logging in
# (POST /api/v1/admin/api-keys) — there is no environment variable for
# this anymore; see README "API keys" for details.

# Seeds the first admin dashboard account (POST /api/v1/admin/login) on
# startup, only if no admin account exists yet — safe to leave both set
# across restarts/redeploys, since this is a no-op once an admin exists.
# Password must be at least 12 characters. If no admin exists and these
# are unset, the server refuses to start (there would be no way to log in).
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

ALLOWED_MIME_TYPES=image/*,video/*,application/pdf,application/zip,text/plain
BLOCKED_EXTENSIONS=.exe,.bat,.sh,.msi,.dll,.scr

# When true, deleting a file before its TTL also purges its CDN_URL from
# Cloudflare's edge cache. Requires CLOUDFLARE_ZONE_ID and CLOUDFLARE_API_TOKEN.
CLOUDFLARE_CACHE_ENABLED=false
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
