SERVER_PORT=8080
SERVER_MAX_UPLOAD_MB=100

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tempcdn-files
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://cdn.tempcdn.example.com

DATABASE_DSN=file:tempcdn.db?cache=shared&_fk=1
FILE_TTL_HOURS=24

RATE_LIMIT_MAX_CONCURRENT_UPLOADS=50

IP_HASH_SALT=change-me-to-a-random-secret

# Origin allowed to call this API from a browser (e.g. https://tempcdn.eu.cc).
# Required — the server refuses to start without it.
ALLOWED_ORIGIN=https://tempcdn.eu.cc

ALLOWED_MIME_TYPES=image/*,video/*,application/pdf,application/zip,text/plain
BLOCKED_EXTENSIONS=.exe,.bat,.sh,.msi,.dll,.scr
